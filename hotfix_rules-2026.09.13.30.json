{
  "schema": 1,
  "revision": 2026091302,
  "description": "zShip declarative self-healing rules. Data only; never executable code.",
  "resolver": {
    "auto_lazy": {
      "enabled": true,
      "slow_seconds": 8.0,
      "min_eager_calls": 2,
      "failure_window_seconds": 86400
    },
    "generic_extract": {
      "enabled": true,
      "timeout": 6,
      "max_bytes": 524288,
      "patterns": [
        "(?:file|src|url)\\s*[:=]\\s*[\\\"']([^\\\"']+\\.(?:m3u8|mp4)(?:\\?[^\\\"']*)?)[\\\"']",
        "<source[^>]+src=[\\\"']([^\\\"']+)[\\\"']"
      ]
    },
    "preflight_rules": [
      {
        "id": "movie2k2-firestream-hls",
        "provider": "movie2k2",
        "hoster_contains": "firestream",
        "url_contains": ".m3u8",
        "type": "hls_first_segment",
        "timeout": 5
      }
    ],
    "candidate_detection": {
      "enabled": true,
      "min_alternative_success_streak": 3,
      "recent_hours": 24
    }
  },
  "providers": {
    "hdfilme": {
      "force_lazy_resolve": true
    },
    "movie2k2": {
      "force_lazy_resolve": true
    },
    "vixstream": {
      "extract": {
        "video_id_patterns": [
          "\\bid\\s*:\\s*[\\\"']?([^,\\\"'\\s}]+)",
          "[\\\"']id[\\\"']\\s*:\\s*[\\\"']?([^,\\\"'\\s}]+)"
        ],
        "token_patterns": [
          "[\\\"']?token[\\\"']?\\s*:\\s*[\\\"']([^\\\"']+)",
          "\\btoken\\s*=\\s*[\\\"']([^\\\"']+)"
        ],
        "expires_patterns": [
          "[\\\"']?expires[\\\"']?\\s*:\\s*[\\\"']([^\\\"']+)",
          "\\bexpires\\s*=\\s*[\\\"']([^\\\"']+)"
        ],
        "playlist_patterns": [
          "\\burl\\s*:\\s*[\\\"']([^\\\"']+)",
          "[\\\"']url[\\\"']\\s*:\\s*[\\\"']([^\\\"']+)",
          "(https?://[^\\\"'\\s]+/playlist/[^\\\"'\\s]+)"
        ]
      },
      "playlist_strategies": [
        {
          "id": "master-api-xhr-origin",
          "url": "master",
          "referer": "api",
          "origin": "root",
          "accept": "xhr"
        },
        {
          "id": "master-api-hls-origin",
          "url": "master",
          "referer": "api",
          "origin": "root",
          "accept": "hls"
        },
        {
          "id": "master-embed-hls-origin",
          "url": "master",
          "referer": "embed",
          "origin": "root",
          "accept": "hls",
          "sec_fetch": "cors"
        },
        {
          "id": "master-root-hls-origin",
          "url": "master",
          "referer": "root",
          "origin": "root",
          "accept": "hls"
        },
        {
          "id": "master-api-xhr-noorigin",
          "url": "master",
          "referer": "api",
          "origin": "omit",
          "accept": "xhr"
        },
        {
          "id": "legacy-api-xhr-origin",
          "url": "legacy",
          "referer": "api",
          "origin": "root",
          "accept": "xhr"
        },
        {
          "id": "legacy-embed-hls-origin",
          "url": "legacy",
          "referer": "embed",
          "origin": "root",
          "accept": "hls"
        },
        {
          "id": "legacy-root-hls-origin",
          "url": "legacy",
          "referer": "root",
          "origin": "root",
          "accept": "hls"
        }
      ]
    }
  }
}
